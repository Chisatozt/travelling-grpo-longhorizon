# Windows terminals often default to a GBK code page.  API responses and
# TravelGym feedback may contain Unicode punctuation, so keep diagnostics from
# turning an otherwise valid rollout into an encoding failure.
for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        try:
            _stream.reconfigure(encoding="utf-8", errors="backslashreplace")
        except (OSError, ValueError):
            pass

