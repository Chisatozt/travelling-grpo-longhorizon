DEFAULT_TEST_SET_MANIFEST_PATH = Path(__file__).resolve().parent / "test_manifests" / "final200.json"
SUPPORTED_ENVS = (
    "travel22",
    "travel33",
    "travel44",
    "travel233",
    "travel333",
    "travel334",
    "travel444",
    "travel2222",
)


def _resolve_repository_path(value: str | Path) -> Path:
    """Resolve a manifest/data path without depending on the current cwd."""
    candidate = Path(value).expanduser()
    if candidate.is_absolute():
        return candidate
    for base in (Path.cwd(), REPOSITORY_ROOT, Path(__file__).resolve().parent):
        resolved = (base / candidate).resolve()
        if resolved.exists():
            return resolved
    # Return a stable repository-relative location for a useful error message.
    return (REPOSITORY_ROOT / candidate).resolve()


def stable_json_hash(value: Any) -> str:
    """Hash a JSON-compatible manifest without exposing its contents."""

    payload = json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        default=str,
    )
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def public_endpoint_label(value: str | None) -> str:
    """Return an API endpoint label with credentials/query strings removed."""

    text = str(value or "").strip()
    if not text:
        return "unset"
    try:
        parsed = urlsplit(text)
        if parsed.scheme and parsed.hostname:
            host = parsed.hostname
            if ":" in host and not host.startswith("["):
                host = f"[{host}]"
            try:
                port = parsed.port
            except ValueError:
                port = None
            netloc = f"{host}:{port}" if port else host
            path = parsed.path.rstrip("/")
            return f"{parsed.scheme}://{netloc}{path}"
    except ValueError:
        pass
    # Invalid/local labels are still made safe for tracking; never retain a
    # query string where an accidental credential could have been embedded.
    return re.sub(r"[?#].*$", "", text).rstrip("/") or "unset"


def resolve_collection_run_id(
    collection_path: Path,
    requested: str | None,
    save_name: str,
) -> str:
    """Create one unique run ID and reuse it when resuming an existing cache."""

    if requested and str(requested).strip():
        return str(requested).strip()
    if collection_path.is_file():
        try:
            payload = json.loads(collection_path.read_text(encoding="utf-8"))
            existing = payload.get("collection_run_id") if isinstance(payload, dict) else None
            if existing:
                return str(existing)
        except (OSError, json.JSONDecodeError):
            # TeacherCache will emit the authoritative malformed-cache error;
            # do not hide it behind run-id discovery.
            pass
    label = re.sub(r"[^A-Za-z0-9_.-]+", "-", Path(str(save_name)).name).strip("-") or "teacher"
    timestamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    return f"{label}-teacher-{timestamp}-{uuid.uuid4().hex[:12]}"


def load_test_set_manifest(path: str | Path) -> tuple[Path, dict]:
    """Load and validate a fixed TravelGym test-set manifest.

    The manifest stores only evaluator-side task IDs.  They are never copied
    into the Actor observation; ``load_data`` uses them solely to select the
    corresponding public prompts from the source parquet files.
    """
    manifest_path = _resolve_repository_path(path)
    if not manifest_path.is_file():
        raise FileNotFoundError(f"TravelGym test-set manifest not found: {manifest_path}")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("manifest_version") != "travelgym-test-set-v1":
        raise ValueError("TravelGym test-set manifest version is incompatible")
    if manifest.get("split") != "test" or manifest.get("dataset_variant") != "multiturn_onechoice":
        raise ValueError("TravelGym test-set manifest must select the one-choice test split")
    records = manifest.get("records")
    if not isinstance(records, list) or not records:
        raise ValueError("TravelGym test-set manifest has no records")
    expected_count = int(manifest.get("task_count", -1))
    if expected_count != len(records):
        raise ValueError(
            f"TravelGym test-set manifest count mismatch: declared {expected_count}, records {len(records)}"
        )
    seen: set[tuple[str, str]] = set()
    actual_counts = {env_name: 0 for env_name in SUPPORTED_ENVS}
    for record in records:
        if not isinstance(record, dict):
            raise ValueError("TravelGym test-set manifest record must be an object")
        env_name = str(record.get("env_name", ""))
        task_id = str(record.get("task_id", ""))
        if env_name not in SUPPORTED_ENVS:
            raise ValueError(f"unsupported environment in test-set manifest: {env_name!r}")
        if not task_id:
            raise ValueError("TravelGym test-set manifest record has no task_id")
        key = (env_name, task_id)
        if key in seen:
            raise ValueError(f"duplicate task in TravelGym test-set manifest: {key!r}")
        seen.add(key)
        actual_counts[env_name] += 1
    declared_counts = manifest.get("selected_env_counts", {})
    if {env: int(declared_counts.get(env, 0)) for env in SUPPORTED_ENVS} != actual_counts:
        raise ValueError("TravelGym test-set manifest selected_env_counts do not match records")

    source_files = manifest.get("source_files", {})
    for env_name in SUPPORTED_ENVS:
        source = source_files.get(env_name)
        if not isinstance(source, dict):
            raise ValueError(f"missing source integrity metadata for {env_name}")
        source_path = _resolve_repository_path(source.get("path", ""))
        if not source_path.is_file():
            raise FileNotFoundError(f"source split for {env_name} not found: {source_path}")
    return manifest_path, manifest


def atomic_json_dump(path: str | Path, value: object) -> None:
    """Persist evaluator state without leaving a half-written cache."""
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_suffix(target.suffix + ".tmp")
    temporary.write_text(
        json.dumps(value, ensure_ascii=False, indent=4),
        encoding="utf-8",
    )
    os.replace(temporary, target)


def invalid_travel_report(reason: str) -> dict[str, object]:
    """Represent an evaluator/infrastructure failure explicitly."""
    return {
        "reward_version": REWARD_VERSION,
        "reward_valid": False,
        "reward_valid_for_training": False,
        "terminal_reward": 0.0,
        "termination_reason": str(reason),
    }


def _is_successful_completion(report: Any) -> bool:
    """Return the pass@k predicate without exposing private labels."""
    if not isinstance(report, Mapping):
        return False
    try:
        return float(report.get("completion_success", report.get("success_completion", 0.0)) or 0.0) >= 1.0
    except (TypeError, ValueError):
        return False
    
async def load_data(env_name, one_choice=True, split="test", task_ids=None):
    if pd is None:
        raise RuntimeError("pandas is required to load TravelGym parquet data; use --dry-run for offline planning")
    if env_name not in SUPPORTED_ENVS:
        raise ValueError(
            f"TravelGym-only evaluator received {env_name!r}; "
            f"choose one of {', '.join(SUPPORTED_ENVS)}"
        )
    if not one_choice:
        raise ValueError("TravelGym evaluation requires the one-choice dataset variant")
    path = f"{PROJECT_ROOT}/../data/{env_name}_multiturn_onechoice/{split}.parquet"
    df = pd.read_parquet(path)
    # Turn into a list of data using only the prompt.  A fixed test-set
    # manifest supplies an ordered ID list; no candidate filtering happens in
    # the environment and no ID is exposed to the Actor before Search.
    rows_by_id = {}
    for i in range(len(df)):
        task_id = str(df.iloc[i]["reward_model"]["id"])
        if task_id in rows_by_id:
            raise ValueError(f"duplicate task ID {task_id!r} in {path}")
        rows_by_id[task_id] = df.iloc[i]
    if task_ids is None:
        ordered_ids = list(rows_by_id)
    else:
        ordered_ids = [str(task_id) for task_id in task_ids]
        if len(set(ordered_ids)) != len(ordered_ids):
            raise ValueError(f"duplicate task ID requested for {env_name}")
        missing = [task_id for task_id in ordered_ids if task_id not in rows_by_id]
        if missing:
            raise ValueError(
                f"test-set manifest contains {len(missing)} task(s) absent from {path}; "
                f"first missing ID: {missing[0]}"
            )
    data = [
        {
            "env_name": env_name,
            "gold": task_id,
            "messages": list(rows_by_id[task_id]["prompt"]),
        }
        for task_id in ordered_ids
    ]
    selection_note = " (manifest selection)" if task_ids is not None else ""
    print(f"Loaded {len(data)} data from {path}{selection_note}")
    return data


def load_task_pool_selection(path: str | Path, pool_name: str) -> tuple[Path, dict, dict[str, list[str]], str]:
    """Load one task-pool view for Teacher/evaluation selection.

    Pool manifests contain private evaluator IDs only.  Any quarantined
    historical SFT rows are absent from the active pool and therefore never
    sent to the environment.
    """

    manifest_path = _resolve_repository_path(path)
    # All online collection/evaluation pools are formal inputs.  The checked-in
    # manifest is strict for active identities; opaque historical rows are
    # already quarantined and absent from the selected records.
    manifest = load_pool_manifest(manifest_path, require_strict=True)
    assert_task_pools_disjoint(manifest)
    pools = manifest.get("pools", {})
    if pool_name not in pools:
        raise TaskPoolError(f"task pool {pool_name!r} is absent from {manifest_path}")
    pool = pools[pool_name]
    records = pool.get("records", []) if isinstance(pool, dict) else []
    if not isinstance(records, list) or not records:
        raise TaskPoolError(f"task pool {pool_name!r} has no records")
    selected: dict[str, list[str]] = {env: [] for env in SUPPORTED_ENVS}
    splits: set[str] = set()
    seen: set[tuple[str, str]] = set()
    for item in records:
        if not isinstance(item, dict):
            raise TaskPoolError("task-pool record must be an object")
        env_name = str(item.get("env_name", ""))
        task_id = str(item.get("task_id", ""))
        if env_name not in SUPPORTED_ENVS or not task_id:
            # ``opaque_sft`` is an audit-only reservation, not an environment
            # task that can be collected/evaluated.
            if pool_name == "sft" and env_name == "opaque_sft":
                continue
            raise TaskPoolError(f"invalid {pool_name} pool record: {item}")
        key = (env_name, task_id)
        if key in seen:
            raise TaskPoolError(f"duplicate task in {pool_name} pool: {key}")
        seen.add(key)
        splits.add(str(item.get("split", "")))
        selected[env_name].append(task_id)
    if len(splits) != 1:
        raise TaskPoolError(f"{pool_name} pool must use one source split, got {sorted(splits)}")
    return manifest_path, manifest, selected, next(iter(splits))


async def build_env(
    data,
    max_turns,
    seed=None,
    telemetry=None,
    *,
    model_client=None,
    user_request_limit=None,
):
    gold = data["gold"]
    env_name = data["env_name"]
    model_name = os.environ.get("USER_MODEL_NAME", "gpt-4o")

    if env_name not in SUPPORTED_ENVS:
        raise ValueError(f"TravelGym-only evaluator received unsupported environment {env_name!r}")

    print("Building environment...", env_name)
    import travelgym

    config = travelgym.get_default_config()
    config.max_steps = max_turns
    config.data_mode = "single"
    config.data_source = gold
    config.model_name = model_name
    config.seed = seed
    config.user_simulator_mode = (
        "deepseek_api"
        if model_client is not None
        else os.environ.get("TRAVELGYM_USER_SIMULATOR", config.user_simulator_mode)
    )
    # The environment's User Simulator uses the same OpenAI-compatible
    # endpoint.  Keep its per-call timeout configurable for remote Teacher
    # collection; the historical TravelGym default remains 15 seconds when
    # no evaluator timeout is provided.
    config.timeout = float(
        os.environ.get(
            "TRAVELGYM_USER_TIMEOUT",
            os.environ.get("OPENAI_REQUEST_TIMEOUT", config.timeout),
        )
    )
    config.one_choice_per_aspect = True
    config.reward_version = "travelgym-terminal-v2"
    config.require_action_before_answer = False
    env = travelgym.TravelEnv(config=config)
    if isinstance(telemetry, dict):
        env._telemetry = telemetry
    # These are evaluator-private handles.  TravelGym copies them into the
    # internal User Simulator model config, never into the public observation
    # or conversation history.  Reusing the collection client avoids opening
    # one HTTP connection per simulator call.
    env._model_client = model_client
    env._request_semaphore = user_request_limit
    env._model_max_attempts = _positive_int_env("MODEL_MAX_ATTEMPTS", 3)
    env.reset()
    return env


def _usage_value(container, key, default=0):
    if container is None:
        return default
    if isinstance(container, dict):
        return container.get(key, default) or default
    return getattr(container, key, default) or default


def _record_actor_usage(telemetry, response, elapsed_seconds):
    """Accumulate private Teacher usage without touching public messages."""
    if not isinstance(telemetry, dict) or response is None:
        return
    usage = getattr(response, "usage", None)
    details = _usage_value(usage, "completion_tokens_details", None)
    telemetry["actor_api_calls"] = telemetry.get("actor_api_calls", 0) + 1
    telemetry["actor_prompt_tokens"] = telemetry.get("actor_prompt_tokens", 0) + int(_usage_value(usage, "prompt_tokens"))
    telemetry["actor_completion_tokens"] = telemetry.get("actor_completion_tokens", 0) + int(_usage_value(usage, "completion_tokens"))
    telemetry["actor_total_tokens"] = telemetry.get("actor_total_tokens", 0) + int(_usage_value(usage, "total_tokens"))
    telemetry["actor_reasoning_tokens"] = telemetry.get("actor_reasoning_tokens", 0) + int(_usage_value(details, "reasoning_tokens"))
    telemetry["actor_wall_time_seconds"] = telemetry.get("actor_wall_time_seconds", 0.0) + float(elapsed_seconds)


def _new_telemetry():
    return {
        "actor_api_calls": 0,
        "actor_api_errors": 0,
        "actor_retries": 0,
        "actor_prompt_tokens": 0,
        "actor_completion_tokens": 0,
        "actor_total_tokens": 0,
        "actor_reasoning_tokens": 0,
        "actor_wall_time_seconds": 0.0,
        "user_api_calls": 0,
        "user_api_errors": 0,
        "user_retries": 0,
        "user_prompt_tokens": 0,
        "user_completion_tokens": 0,
        "user_total_tokens": 0,
        "user_reasoning_tokens": 0,
        "user_wall_time_seconds": 0.0,
        "missing_think_turns": 0,
    }


def _extract_think_text(text):
    """Return the inner text of an already formatted think block."""
    if not isinstance(text, str):
        return ""
    match = re.search(r"<think>\s*(.*?)\s*</think>", text, flags=re.IGNORECASE | re.DOTALL)
    return match.group(1).strip() if match else ""


def _normalise_reasoning_text(value):
    """Keep reasoning_content independent from visible/tool content."""
    text = str(value or "").strip()
    wrapped = _extract_think_text(text)
    return wrapped if wrapped else text


def _sft_assistant_message(response, json_args, model_name, include_think=False, think_fallback="omit"):
    """Serialize one Actor turn for the optional CoT-aware SFT export.

    The evaluator's working transcript still carries DeepSeek's
    ``reasoning_content`` for API protocol correctness.  This helper only
    affects the separate ``json_data`` copy used for SFT export.
    """
    tool_payload = {
        "name": "interact_with_env",
        "arguments": json_args,
    }
    if not include_think:
        return {"role": "assistant", "content": tool_payload}

    think_text = ""
    message = None
    if "gemini" not in model_name.lower():
        message = getattr(response.choices[0], "message", None)
    if message is not None:
        think_text = _normalise_reasoning_text(getattr(message, "reasoning_content", None))
        if not think_text:
            think_text = _extract_think_text(getattr(message, "content", None))
        if not think_text and think_fallback == "content":
            think_text = str(getattr(message, "content", None) or "").strip()

    tool_block = "<tool_call>\n" + json.dumps(tool_payload, ensure_ascii=False) + "\n</tool_call>"
    if think_text:
        content = f"<think>\n{think_text}\n</think>\n\n{tool_block}"
    else:
        content = tool_block
    result = {"role": "assistant", "content": content}
    # Keep an independent reasoning_content field in the private Teacher
    # cache as well as the legacy <think> renderer.  Canonicalisation strips
    # the wrapper and replays this field through Qwen's native template.
    if think_text:
        result["reasoning_content"] = think_text
    return result


def _provider_error_label(exc: BaseException) -> str:
    """Return a credential-free provider error label for logs/telemetry."""

    status = getattr(exc, "status_code", None)
    if status is None:
        response = getattr(exc, "response", None)
        status = getattr(response, "status_code", None)
    return f"{type(exc).__name__}(status={status})"


def _is_transient_provider_error(exc: BaseException) -> bool:
    """Retry only transport, throttling and server-side failures."""

    status = getattr(exc, "status_code", None)
    if status is None:
        response = getattr(exc, "response", None)
        status = getattr(response, "status_code", None)
    if status is not None:
        try:
            status = int(status)
        except (TypeError, ValueError):
            status = None
        if status in {408, 409, 425, 429} or (status is not None and status >= 500):
            return True
        if status is not None:
            return False
    name = type(exc).__name__.casefold()
    return any(token in name for token in ("timeout", "connection", "network", "rate", "server"))


def _retry_delay(attempt_index: int) -> float:
    """Small exponential backoff with jitter; never blocks longer than 8s."""

    return min(8.0, 1.0 * (2 ** max(0, int(attempt_index))) + random.random() * 0.5)


async def gen_response(client, data, schema, temperature, model_name, thinking=None, telemetry=None, reasoning_effort=None):
    configured_tool_choice = str(os.environ.get("TOOL_CHOICE", "required")).lower()
    # DeepSeek thinking mode rejects tool_choice="required".  Keep the
    # explicit setting for other providers, but degrade safely to auto for
    # DeepSeek so a stale .env cannot turn every rollout into a 400 response.
    tool_choice = configured_tool_choice
    if "deepseek" in model_name.lower() and configured_tool_choice == "required":
        tool_choice = "auto"
    max_output_tokens = int(os.environ.get("MAX_OUTPUT_TOKENS", 4096))
    max_attempts = max(1, int(os.environ.get("MODEL_MAX_ATTEMPTS", 3)))
    for attempt_index in range(max_attempts):
        try:
            if "gemini" in model_name:
                if Client is None or types is None:
                    raise RuntimeError("Gemini SDK is not installed")
                interact_tool = copy.deepcopy(schema["function"])
                tools = types.Tool(function_declarations=[interact_tool])
                config = types.GenerateContentConfig(
                    tools=[tools],
                    temperature=temperature,
                    max_output_tokens=2048,
                    tool_config=types.ToolConfig(function_calling_config=types.FunctionCallingConfig(mode=types.FunctionCallingConfigMode.ANY))
                )
                contents = [
                    types.Content(role="user", parts=[
                        types.Part(text=data["messages"][0]["content"]),
                        types.Part(text=data["messages"][1]["content"])
                    ])
                ]
                for message in data["messages"][2:]:
                    contents.append(message["content"])
                request_started = time.perf_counter()
                async with actor_request_semaphore:
                    response = await client.aio.models.generate_content(
                        model=model_name,
                        contents=contents,
                        config=config,
                    )
                _record_actor_usage(telemetry, response, time.perf_counter() - request_started)
                part_exists = response.candidates[0].content.parts[0]
                return response
            
            else:
                request_kwargs = {
                    "model": model_name,
                    "messages": data["messages"],
                    "tools": [schema],
                    "tool_choice": "required" if tool_choice == "required" else "auto",
                    "temperature": temperature,
                    "max_tokens": max_output_tokens,
                    "n": 1,
                }
                # DeepSeek V4 Flash exposes thinking through the OpenAI-
                # compatible ``extra_body`` field.  Keep this opt-in at the
                # evaluator boundary so public tool feedback is identical in
                # enabled/disabled comparisons; only the Teacher's private
                # reasoning budget changes.
                if "deepseek" in model_name.lower() and thinking in {"enabled", "disabled"}:
                    request_kwargs["extra_body"] = {
                        "thinking": {"type": thinking},
                    }
                    if reasoning_effort:
                        request_kwargs["extra_body"]["reasoning_effort"] = str(reasoning_effort)
                elif "qwen3" in model_name.lower() and os.environ.get("QWEN_ENABLE_THINKING", "1").strip().lower() not in {"0", "false", "no"}:
                    # vLLM/SGLang versions that expose Qwen3's native
                    # template accept this request-scoped flag.  It keeps
                    # reasoning enabled without serialising a duplicate
                    # ``<think>`` block in the message content.
                    request_kwargs["extra_body"] = {
                        "chat_template_kwargs": {"enable_thinking": True},
                    }
                request_started = time.perf_counter()
                async with actor_request_semaphore:
                    response = await client.chat.completions.create(**request_kwargs)
                _record_actor_usage(telemetry, response, time.perf_counter() - request_started)
                return response

        except Exception as e:
            if isinstance(telemetry, dict):
                telemetry["actor_api_errors"] = telemetry.get("actor_api_errors", 0) + 1
                if _is_transient_provider_error(e):
                    telemetry["actor_retries"] = telemetry.get("actor_retries", 0) + int(
                        attempt_index + 1 < max_attempts
                    )
            print(f"[local tool call] failed: {_provider_error_label(e)}")
            if attempt_index + 1 >= max_attempts or not _is_transient_provider_error(e):
                break
            await asyncio.sleep(_retry_delay(attempt_index))

    print(f"[local tool call] failed after {max_attempts} attempts; check the model name and API key.")
    raise RuntimeError(f"Local function_call failed after {max_attempts} attempts")


def _serialize_tool_call(tool_call):
    """Convert an SDK tool-call object into an API-safe plain dictionary."""
    if isinstance(tool_call, dict):
        return tool_call
    function = getattr(tool_call, "function", None)
    return {
        "id": getattr(tool_call, "id", None),
        "type": getattr(tool_call, "type", "function") or "function",
        "function": {
            "name": getattr(function, "name", "") if function is not None else "",
            "arguments": getattr(function, "arguments", "{}") if function is not None else "{}",
        },
    }


def _append_chat_assistant_and_tool_messages(data, response, feedback, model_name, fallback_arguments=None):
    """Append a standards-compliant assistant/tool exchange for the next API call.

    DeepSeek thinking mode requires the full ``reasoning_content`` and every
    returned tool call to be replayed.  The environment executes only the
    first call per evaluator turn, so additional calls receive a neutral
    rejection result while retaining their IDs for protocol correctness.
    """
    message = response.choices[0].message
    tool_calls = list(getattr(message, "tool_calls", None) or [])
    raw_content = getattr(message, "content", None) or ""
    if not isinstance(raw_content, str):
        raw_content = str(raw_content)
    reasoning_content = getattr(message, "reasoning_content", None)
    # Some OpenAI-compatible servers expose the parser output in
    # ``content`` even when ``reasoning_content`` is present.  Keep one
    # independent reasoning field and remove only the wrapper from visible
    # content; never prepend a second ``<think>`` block for Qwen3.5.
    embedded_reasoning = _extract_think_text(raw_content)
    if reasoning_content:
        raw_content = re.sub(r"<think>\s*.*?\s*</think>", "", raw_content, flags=re.IGNORECASE | re.DOTALL).strip()
    elif embedded_reasoning:
        reasoning_content = embedded_reasoning
        raw_content = re.sub(r"<think>\s*.*?\s*</think>", "", raw_content, flags=re.IGNORECASE | re.DOTALL).strip()
    assistant_message = {
        "role": "assistant",
        # DeepSeek requires assistant content to be non-null when tools are
        # present; an empty string is the canonical representation.
        "content": raw_content,
    }
    if reasoning_content:
        # Keep reasoning independent for both DeepSeek and Qwen3.5.  The
        # model-native template decides how the field is serialized; manually
        # prepending <think> here would duplicate the block for Qwen3.5.
        assistant_message["reasoning_content"] = _normalise_reasoning_text(reasoning_content)
    if not tool_calls and isinstance(fallback_arguments, Mapping):
        # Some OpenAI-compatible servers put a legacy <tool_call> block in
        # ``content`` instead of populating ``message.tool_calls``.  Convert
        # that already-validated payload into the structured replay form so
        # the next request still receives the tool observation.
        tool_calls = [{
            "id": "call_0000",
            "type": "function",
            "function": {
                "name": "interact_with_env",
                "arguments": json.dumps(dict(fallback_arguments), ensure_ascii=False, separators=(",", ":")),
            },
        }]
        assistant_message["content"] = re.sub(
            r"<tool_call>\s*.*?\s*</tool_call>",
            "",
            assistant_message.get("content", ""),
            flags=re.IGNORECASE | re.DOTALL,
        ).strip()
    if tool_calls:
        assistant_message["tool_calls"] = [_serialize_tool_call(call) for call in tool_calls]
    data["messages"].append(assistant_message)

    if not tool_calls:
        return
    first_payload = _serialize_tool_call(tool_calls[0])
    first_id = first_payload.get("id")
    first_result = {"role": "tool", "content": sanitize_public_feedback(feedback)}
    if first_id:
        first_result["tool_call_id"] = first_id
    data["messages"].append(first_result)
    for extra_call in tool_calls[1:]:
        extra_id = _serialize_tool_call(extra_call).get("id")
        extra_result = {
            "role": "tool",
            "content": "Only one tool call is processed per evaluator turn; retry this operation in the next turn.",
        }
        if extra_id:
            extra_result["tool_call_id"] = extra_id
        data["messages"].append(extra_result)


def hash(data):
    return hashlib.sha256(json.dumps(data).encode()).hexdigest()


async def rollout(
    data,
    client,
    function,
    temperature,
    max_turns,
    model_name,
    thinking=None,
    seed=None,
    include_think=False,
    think_fallback="omit",
    require_think=False,
    reasoning_effort=None,
    pass_index=None,
    provenance=None,
    user_model_client=None,
):
    turn = 0
    turn_rewards = []
    hash_id = hash(data)
    history = []
    json_data = copy.deepcopy(data)
    telemetry = _new_telemetry()
    rollout_started = time.perf_counter()

    try:
        env = await build_env(
            data,
            max_turns,
            seed=seed,
            telemetry=telemetry,
            # Evaluation may serve the local Actor while retaining the
            # externally configured DeepSeek User Simulator.  Keep the
            # historical single-client behavior when no override is given.
            model_client=user_model_client if user_model_client is not None else client,
            user_request_limit=user_request_semaphore,
        )
        while turn < max_turns:
            if "gemini" in model_name:
                response = await gen_response(
                    client, data, function, temperature, model_name,
                    thinking=thinking, telemetry=telemetry,
                    reasoning_effort=reasoning_effort,
                )
                # print(f"Model response: {response}")
                try:
                    json_args = response.candidates[0].content.parts[0].function_call.args
                    if isinstance(json_args, str):
                        json_args = json.loads(json_args)
                except Exception as e:
                    assert False, f"Invalid response (response without tool call detected): {response}"
            else:
                response = await gen_response(
                    client, data, function, temperature, model_name,
                    thinking=thinking, telemetry=telemetry,
                    reasoning_effort=reasoning_effort,
                )
                tool_calls = list(getattr(response.choices[0].message, "tool_calls", None) or [])
                if os.environ.get("VERBOSE_MODEL_RESPONSES", "0") == "1":
                    print(f"Model response: {response}")
                else:
                    finish_reason = getattr(response.choices[0], "finish_reason", None)
                    print(
                        f"Model response: finish_reason={finish_reason}, "
                        f"tool_calls={len(tool_calls)}"
                    )
                try:
                    # Prefer the provider's structured ``tool_calls`` field;
                    # the shared adapter also accepts Qwen/DeepSeek legacy
                    # ``<tool_call>`` content when a server serializes it
                    # there.  Both paths produce the same public
                    # choice/content object before TravelGym sees it.
                    message_obj = response.choices[0].message
                    structured_calls = list(getattr(message_obj, "tool_calls", None) or [])
                    if structured_calls:
                        parsed_calls = [normalize_tool_call(_serialize_tool_call(structured_calls[0]))]
                    else:
                        # The adapter's content fallback handles servers that
                        # serialize the call as a legacy <tool_call> block.
                        parsed_calls = parse_assistant_tool_calls({
                            "content": getattr(message_obj, "content", "") or "",
                        })
                    if not parsed_calls:
                        raise TravelToolAdapterError("response contained no tool call")
                    json_args = parsed_calls[0]
                except (Exception, TravelToolAdapterError) as e:
                    assert False, f"Invalid response (response without tool call detected): {response}"

            choice = json_args["choice"]
            content = json_args["content"]
            formatted_action = format_environment_action(json_args)
            
            observation, reward, terminated, truncated, info = await asyncio.wait_for(
                env.step_async(formatted_action),
                timeout=120.0
            )
            assert_public_observation(observation)
            feedback = sanitize_public_feedback(observation["feedback"])

            if len(feedback) > 512 and choice == "search":
                output_feedback = feedback[:256] + "  ... ... " + feedback[-256:]
            else:
                output_feedback = feedback
            
            print(f"In {data['env_name']}, turn {turn}, action: {formatted_action}, feedback: {output_feedback}, reward: {reward}")
            # TravelGym deliberately returns zero at each interaction step;
            # the scalar used for evaluation is computed once at episode end.
            turn_rewards.append(reward)

            history.append({
                "turn": turn,
                "choice": choice,
                "content": content,
                "feedback": feedback,
                "reward": reward,
            })

            sft_assistant_message = _sft_assistant_message(
                response,
                json_args,
                model_name,
                include_think=include_think,
                think_fallback=think_fallback,
            )
            # Preserve an explicit length/truncation signal in the private
            # derived cache.  The canonical cleaner uses it to remove the
            # complete untrusted suffix; normal ``tool_calls``/``stop`` turns
            # remain ordinary supervised candidates.
            if "gemini" not in model_name.lower():
                finish_reason = getattr(response.choices[0], "finish_reason", None)
                if finish_reason not in {None, "stop", "tool_calls"}:
                    sft_assistant_message["finish_reason"] = str(finish_reason)
            if require_think and not _extract_think_text(sft_assistant_message.get("content")):
                telemetry["missing_think_turns"] = telemetry.get("missing_think_turns", 0) + 1
                raise RuntimeError(
                    "Teacher response did not expose reasoning_content; "
                    "the SFT collection requires a non-empty <think>...</think> block"
                )
            json_data["messages"].append(sft_assistant_message)
            json_data["messages"].append({
                "role": "tool",
                "content": feedback
            })

            if terminated or truncated:
                break

            if "gemini" in model_name:
                tool_call = response.candidates[0].content.parts[0].function_call
                function_response_part = types.Part.from_function_response(name=tool_call.name, response={"result": feedback})
                response_content = types.Content(role="user", parts=[function_response_part])
                data["messages"].append({"role": "assistant", "content": response.candidates[0].content})
                data["messages"].append({"role": "tool", "content": response_content})
            else:
                _append_chat_assistant_and_tool_messages(
                    data, response, feedback, model_name, fallback_arguments=json_args
                )
            turn += 1
            
        if hasattr(env, "get_reward_report"):
            reward_report = env.get_reward_report(finalize=True)
            reward_report = summarize_terminal_report(reward_report)
            total_reward = float(reward_report["terminal_reward"])
        else:
            reward_report = None
            total_reward = turn_rewards
        telemetry["rollout_elapsed_seconds"] = time.perf_counter() - rollout_started
        telemetry["api_total_tokens"] = telemetry["actor_total_tokens"] + telemetry["user_total_tokens"]
        return {
            "hash_id": hash_id,
            "reward": total_reward,
            "reward_report": reward_report,
            "history": history,
            "data": json_data,
            "telemetry": telemetry,
            "pass_index": pass_index,
            "provenance": dict(provenance or {}),
        }
    
    except asyncio.TimeoutError:
        print(f"==================== [local] rollout timeout !!! ====================")
        total_reward = 0.0
        report = invalid_travel_report("evaluation_timeout")
        telemetry["rollout_elapsed_seconds"] = time.perf_counter() - rollout_started
        telemetry["api_total_tokens"] = telemetry["actor_total_tokens"] + telemetry["user_total_tokens"]
        return {
            "hash_id": hash_id,
            "reward": total_reward,
            "reward_report": report,
            "history": history,
            "data": json_data,
            "telemetry": telemetry,
            "pass_index": pass_index,
            "provenance": dict(provenance or {}),
        }

    except Exception as e:
        print(f"==================== [local] rollout failed: {e} ====================")
        total_reward = 0.0
        reason = "missing_think" if telemetry.get("missing_think_turns", 0) else "evaluation_error"
        report = invalid_travel_report(reason)
        telemetry["rollout_elapsed_seconds"] = time.perf_counter() - rollout_started
        telemetry["api_total_tokens"] = telemetry["actor_total_tokens"] + telemetry["user_total_tokens"]
        return {
            "hash_id": hash_id,
            "reward": total_reward,
            "reward_report": report,
            "history": history,
            "data": json_data,
            "telemetry": telemetry,
            "pass_index": pass_index,
            "provenance": dict(provenance or {}),
        }


async def post_process_results(results, reward_cache, env, pass_k):
    if env not in SUPPORTED_ENVS:
        raise ValueError(f"TravelGym-only evaluator received unsupported environment {env!r}")
    results[env][str(pass_k)] = {}
    micro_avg = []
    valid_rollouts = 0
    total_rollouts = 0
    pass_success_tasks = 0
    for hash_id in reward_cache[env]:
        terminal_scores = reward_cache[env][hash_id]["reward"]
        micro_avg.append(sum(terminal_scores) / len(terminal_scores) if terminal_scores else 0.0)
        reports = reward_cache[env][hash_id].get("reward_report", [])
        pass_success_tasks += int(any(_is_successful_completion(report) for report in reports))
        total_rollouts += len(terminal_scores)
        valid_rollouts += sum(
            int(bool(report.get("reward_valid", False)))
            for report in reports
            if isinstance(report, dict)
        )
    results[env][str(pass_k)]["micro_avg"] = sum(micro_avg) / len(micro_avg) if micro_avg else 0.0
    results[env][str(pass_k)]["terminal_max"] = max(
        (max(reward_cache[env][hash_id]["reward"]) if reward_cache[env][hash_id]["reward"] else 0.0)
        for hash_id in reward_cache[env]
    ) if reward_cache[env] else 0.0
    results[env][str(pass_k)]["reward_version"] = REWARD_VERSION
    results[env][str(pass_k)]["valid_rollout_rate"] = (
        valid_rollouts / total_rollouts if total_rollouts else 0.0
    )
    results[env][str(pass_k)]["invalid_rollout_count"] = total_rollouts - valid_rollouts
    task_count = len(micro_avg)
    results[env][str(pass_k)][f"pass@{pass_k}"] = (
        pass_success_tasks / task_count if task_count else 0.0
    )
    results[env][str(pass_k)]["pass_definition"] = "completion_success==1"
    results[env][str(pass_k)]["early_stop"] = True
    results[env][str(pass_k)]["task_count"] = task_count
    terminal_max = results[env][str(pass_k)]["terminal_max"]
    print(f"\n ######### Pass {pass_k} terminal reward: {terminal_max} ######### \n")
    return results


async def limited_rollout(*args, **kwargs):
    async with rollout_semaphore:
        return await rollout(*args, **kwargs)
    

async def main():
    arg_parser = argparse.ArgumentParser()
    arg_parser.add_argument(
        "--model_name",
        type=str,
        default=os.getenv("ACTOR_MODEL_NAME") or os.getenv("USER_MODEL_NAME") or "Qwen2.5-7B-Instruct",
    )
    arg_parser.add_argument("--port", type=int, default=8000)
    arg_parser.add_argument("--max_turns", type=int, default=25)
    arg_parser.add_argument("--pass_k", type=int, nargs="+", default=[1])
    arg_parser.add_argument("--temperature", type=float, default=1.0)
    arg_parser.add_argument(
        "--thinking",
        choices=("enabled", "disabled"),
        default=os.getenv("DEEPSEEK_THINKING", "enabled").strip().lower(),
        help="DeepSeek thinking mode for Teacher calls (ignored by other providers).",
    )
    arg_parser.add_argument(
        "--include-think",
        action="store_true",
        help="Include a <think> block in exported SFT assistant messages when reasoning is available (automatic for DeepSeek enabled mode).",
    )
    arg_parser.add_argument(
        "--think-fallback",
        choices=("omit", "content"),
        default="omit",
        help="When --include-think is set but no reasoning_content exists, optionally wrap visible model content as a plan.",
    )
    arg_parser.add_argument(
        "--require-think",
        action="store_true",
        help="Fail a rollout if an exported assistant tool turn has no non-empty <think>...</think> block.",
    )
    arg_parser.add_argument(
        "--sft-collection",
        action="store_true",
        help="SFT collection mode: require DeepSeek Thinking and strict <think> export.",
    )
    arg_parser.add_argument(
        "--reasoning-effort",
        choices=("low", "medium", "high"),
        default=os.getenv("DEEPSEEK_REASONING_EFFORT", "high"),
        help="Request-scoped DeepSeek reasoning effort (Teacher collection defaults to high).",
    )
    arg_parser.add_argument(
        "--collection-cache",
        default=os.getenv("TEACHER_COLLECTION_CACHE"),
        help="Private idempotent Teacher cache (one record per env/task/pass).",
    )
    arg_parser.add_argument(
        "--collection-run-id",
        default=os.getenv("TEACHER_COLLECTION_RUN_ID"),
        help="Private collection run identifier stored in cache provenance.",
    )
    arg_parser.add_argument(
        "--estimated-cost-per-1k-tokens",
        type=float,
        default=float(os.getenv("DEEPSEEK_ESTIMATED_COST_PER_1K", "0")),
        help="Optional local price used only for scalar collection/* estimated_cost tracking.",
    )
    arg_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Enumerate pending work and validate manifests without creating an API client or rollout.",
    )
    arg_parser.add_argument(
        "--seed",
        type=int,
        default=None,
        help="Optional TravelGym seed for reproducible environment initialization.",
    )
    arg_parser.add_argument(
        "--envs",
        type=str,
        nargs="+",
        default=list(SUPPORTED_ENVS),
        help="TravelGym dataset variants to evaluate.",
    )
    arg_parser.add_argument(
        "--test-manifest",
        type=str,
        default=os.getenv("TRAVEL_TEST_MANIFEST", str(DEFAULT_TEST_SET_MANIFEST_PATH)),
        help=(
            "Fixed TravelGym test-set manifest used when --task-pool-manifest is not supplied. "
            "The default is the 200-task final validation set."
        ),
    )
    arg_parser.add_argument(
        "--task-pool-manifest",
        type=str,
        default=os.getenv("TRAVEL_TASK_POOL_MANIFEST"),
        help=(
            "Disjoint TravelGym task-pool manifest. Teacher SFT collection "
            "must use pool=sft; ordinary evaluation uses validation or "
            "validation_smoke."
        ),
    )
    arg_parser.add_argument(
        "--task-pool",
        choices=("sft", "sft_smoke", "grpo", "validation", "validation_smoke"),
        default=None,
        help="Pool selected from --task-pool-manifest (default: sft for Teacher, validation otherwise).",
    )
    arg_parser.add_argument(
        "--max_tasks",
        type=int,
        default=None,
        help="Optionally limit each selected environment to the first N manifest tasks.",
    )
    arg_parser.add_argument(
        "--collection-task-limit",
        type=int,
        default=(
            int(os.environ["TEACHER_COLLECTION_TASK_LIMIT"])
            if os.environ.get("TEACHER_COLLECTION_TASK_LIMIT", "").strip().isdigit()
            else None
        ),
        help=(
            "SFT collection only: cap the total number of new teacher Task identities "
            "for a smoke run. Historical tasks are always excluded."
        ),
    )
    arg_parser.add_argument("--save_name", type=str, default="results")

    args = arg_parser.parse_args()
    if args.estimated_cost_per_1k_tokens < 0:
        raise ValueError("--estimated-cost-per-1k-tokens must be non-negative")

    # DeepSeek-V4-Flash Teacher collection is the canonical source for the
    # CoT-aware SFT corpus.  Keep the comparison switch available for older
    # diagnostic runs, but make the SFT-safe default impossible to forget:
    # enabled Thinking automatically exports and validates <think> blocks.
    is_deepseek_teacher = "deepseek" in args.model_name.lower()
    if args.sft_collection:
        if not is_deepseek_teacher:
            raise ValueError("--sft-collection requires a DeepSeek Teacher model")
        if args.thinking != "enabled":
            raise ValueError("--sft-collection requires --thinking enabled")
        args.include_think = True
        args.require_think = True
        args.think_fallback = "omit"
        args.max_turns = 25
        # ``pass_k`` in legacy evaluator mode means number of samples.  The
        # Teacher protocol is explicit and always two fixed pass indices.
        args.pass_k = [2]
        if not args.task_pool_manifest:
            raise ValueError(
                "--sft-collection requires --task-pool-manifest and --task-pool sft; "
                "build data/task_pools/travel_task_pools.json first"
            )
        if args.task_pool not in (None, "sft", "sft_smoke"):
            raise ValueError("--sft-collection can only use the sft or sft_smoke task pool")
    if is_deepseek_teacher and args.thinking == "enabled":
        args.include_think = True
        args.require_think = True
    if is_deepseek_teacher and args.thinking == "disabled" and args.include_think:
        raise ValueError(
            "DeepSeek disabled Thinking cannot be exported as SFT with <think>; "
            "use --thinking enabled or omit --include-think for a diagnostic run"
        )

    unsupported_envs = [env for env in args.envs if env not in SUPPORTED_ENVS]
    if unsupported_envs:
        raise ValueError(
            f"TravelGym-only evaluator does not support {unsupported_envs}; "
            f"choose from {', '.join(SUPPORTED_ENVS)}"
        )

    print(args)

    # Resolve the public endpoint label once for both dry-run metadata and
    # real API clients.  Only scheme/host/path are retained; credentials and
    # query strings never enter manifests or SwanLab config.
    base_url = os.environ.get("OPENAI_BASE_URL")
    if not base_url:
        base_url = (
            "https://api.openai.com/v1"
            if "gpt" in args.model_name.lower() and "gpt-oss" not in args.model_name.lower()
            else f"http://localhost:{args.port}/v1"
        )
    api_endpoint_label = (
        "google-genai" if "gemini" in args.model_name.lower() else public_endpoint_label(base_url)
    )
    revision = code_revision()

    if args.dry_run:
        client = None
    elif "gemini" in args.model_name.lower():
        if Client is None:
            raise RuntimeError("Gemini SDK is not installed")
        client = Client(api_key=os.environ["GENAI_API_KEY"])
    else:
        if AsyncOpenAI is None:
            raise RuntimeError("OpenAI-compatible SDK is not installed; use --dry-run for offline planning")
        # All non-Gemini actors use the OpenAI-compatible Chat Completions
        # interface.  The endpoint was resolved above so the exact same safe
        # label is stored in the collection manifest and tracking run.
        api_key = (
            os.environ.get("OPENAI_API_KEY")
            or os.environ.get("DEEPSEEK_API_KEY")
            or "dummy"
        )
        request_timeout = float(os.environ.get("OPENAI_REQUEST_TIMEOUT", 60.0))
        if request_timeout <= 0:
            raise ValueError("OPENAI_REQUEST_TIMEOUT must be positive")
        # Disable the SDK's hidden exponential retries: ``gen_response`` owns
        # the bounded retry policy so a stalled Teacher request cannot block a
        # whole evaluation batch for many minutes.
        client = AsyncOpenAI(
            api_key=api_key,
            base_url=base_url,
            timeout=request_timeout,
            max_retries=0,
        )


    # A local SFT Actor and a remote DeepSeek User Simulator use different
    # OpenAI-compatible endpoints.  The override is opt-in so historical
    # Teacher/evaluator invocations remain single-client compatible.
    user_client = client
    user_api_endpoint_label = api_endpoint_label
    if not args.dry_run and "gemini" not in args.model_name.lower():
        configured_user_url = os.environ.get("TRAVELGYM_USER_BASE_URL")
        configured_user_key = os.environ.get("TRAVELGYM_USER_API_KEY")
        if configured_user_url or configured_user_key:
            user_base_url = configured_user_url or base_url
            user_api_key = (
                configured_user_key
                or os.environ.get("DEEPSEEK_API_KEY")
                or os.environ.get("OPENAI_API_KEY")
                or "dummy"
            )
            user_timeout = float(
                os.environ.get(
                    "TRAVELGYM_USER_TIMEOUT",
                    os.environ.get("OPENAI_REQUEST_TIMEOUT", 60.0),
                )
            )
            if user_timeout <= 0:
                raise ValueError("TRAVELGYM_USER_TIMEOUT must be positive")
            user_client = AsyncOpenAI(
                api_key=user_api_key,
                base_url=user_base_url,
                timeout=user_timeout,
                max_retries=0,
            )
            user_api_endpoint_label = public_endpoint_label(user_base_url)
    function = yaml.safe_load(open(f"{PROJECT_ROOT}/schema/interact_tool.yaml", "r"))["tool_schema"]

    pool_manifest_path = None
    pool_manifest = None
    pool_name = args.task_pool
    pool_split = "test"
    collection_source_task_count = None
    collection_excluded_historical_task_count = 0
    if args.task_pool_manifest:
        pool_name = pool_name or ("sft" if args.sft_collection else "validation")
        pool_manifest_path, pool_manifest, records_by_env, pool_split = load_task_pool_selection(
            args.task_pool_manifest, pool_name
        )
        test_set_manifest_path = pool_manifest_path
        test_set_manifest = pool_manifest
        print(
            f"Using task pool {pool_name}: "
            f"{sum(len(values) for values in records_by_env.values())} resolvable task(s) "
            f"from {pool_manifest_path}"
        )
        # Fail closed for hand-edited manifests too: the string "false" must
        # not become truthy merely because Python's ``bool`` treats every
        # non-empty string as true.
        strict_identity = str(pool_manifest.get("strict_task_identity", False)).strip().casefold() in {
            "true", "1", "yes", "y"
        }
        if args.sft_collection and not strict_identity:
            raise ValueError(
                "Teacher collection requires a strict active task-pool manifest; "
                "regenerate it with sft/task_pools.py if an old preview manifest was supplied"
            )
        if args.sft_collection:
            # The formal SFT pool contains the immutable historical seed and
            # the reserved Teacher expansion.  Only the latter is eligible
            # for a new paid collection; historical task identities are never
            # sent to the API again.  This role filter is private metadata and
            # never enters Actor observations or simulator feedback.
            pool_records = (pool_manifest.get("pools", {}).get(pool_name, {}) or {}).get("records", [])
            selected_keys = {
                (env_name, task_id)
                for env_name, task_ids in records_by_env.items()
                for task_id in task_ids
            }
            eligible_by_env = {env_name: [] for env_name in SUPPORTED_ENVS}
            collection_source_task_count = len(selected_keys)
            for record in pool_records:
                if not isinstance(record, Mapping):
                    raise TaskPoolError("SFT pool record must be an object")
                env_name = str(record.get("env_name", ""))
                task_id = str(record.get("task_id", ""))
                if (env_name, task_id) not in selected_keys:
                    continue
                role = str(record.get("role", "")).strip()
                if role == "teacher_expansion":
                    eligible_by_env.setdefault(env_name, []).append(task_id)
                elif role == "historical_sft":
                    collection_excluded_historical_task_count += 1
                else:
                    raise TaskPoolError(
                        f"SFT collection requires an explicit role for {env_name}::{task_id}; "
                        f"received {role!r}"
                    )
            records_by_env = eligible_by_env
            print(
                "Teacher collection scope: "
                f"{collection_source_task_count} pool task(s), "
                f"{sum(len(values) for values in records_by_env.values())} new Teacher task(s), "
                f"{collection_excluded_historical_task_count} historical task(s) excluded"
            )
    else:
        test_set_manifest_path, test_set_manifest = load_test_set_manifest(args.test_manifest)
        records_by_env = {env_name: [] for env_name in SUPPORTED_ENVS}
        for record in test_set_manifest["records"]:
            records_by_env[record["env_name"]].append(record["task_id"])
        pool_name = None
    selected_env_counts = {env: len(records_by_env.get(env, [])) for env in SUPPORTED_ENVS}
    selected_task_count = sum(selected_env_counts.values())
    selected_set_name = (
        f"{pool_name}@{pool_manifest_path.name}" if pool_manifest is not None else test_set_manifest["name"]
    )
    selected_envs = [env for env in args.envs if records_by_env.get(env)]
    if not selected_envs:
        raise ValueError(
            "none of the requested environments occur in the selected TravelGym test-set manifest"
        )
    if pool_manifest is None:
        print(
            f"Using test-set {test_set_manifest['name']}: "
            f"{test_set_manifest['task_count']} task(s) from {test_set_manifest_path}"
        )

    if args.sft_collection:
        if pool_manifest is None:
            raise ValueError("--sft-collection requires a strict task-pool manifest")
        collection_path = Path(args.collection_cache or f"{args.save_name}_teacher_cache.json")
        run_id = resolve_collection_run_id(collection_path, args.collection_run_id, args.save_name)

    # A task-pool hash is a label only: task IDs remain in the local manifest
    # and are never sent to SwanLab.  Derivative smoke manifests carry the
    # source hash so smoke and full collection phases share one provenance ID.
    selected_task_pool_hash = stable_json_hash(pool_manifest or test_set_manifest)
    task_pool_source_hash = (
        pool_manifest.get("source_manifest_hash")
        if isinstance(pool_manifest, dict)
        else None
    )
    task_pool_hash = str(task_pool_source_hash or selected_task_pool_hash)

    manifest_path = Path(os.environ.get("TRAVEL_MANIFEST_PATH", str(DEFAULT_MANIFEST_PATH)))
    if not manifest_path.is_file():
        raise FileNotFoundError(f"TravelGym manifest not found: {manifest_path}")
    travel_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if travel_manifest.get("contract_version") != "travelgym-public-v1":
        raise ValueError("TravelGym manifest contract version is incompatible")
    if travel_manifest.get("reward_version") != REWARD_VERSION:
        raise ValueError("TravelGym manifest reward version is incompatible")
    if set(travel_manifest.get("actor_forbidden_fields", ())) != set(FORBIDDEN_PUBLIC_KEYS):
        raise ValueError("TravelGym manifest deny-list does not match the public observation contract")
    eval_manifest = make_eval_manifest(
        data_path=str(manifest_path),
        config={
            "envs": list(selected_envs),
            "split": pool_split,
            "one_choice": True,
            "max_turns": int(args.max_turns),
            "temperature": float(args.temperature),
            "thinking": args.thinking,
            "reasoning_effort": args.reasoning_effort,
            "include_think": bool(args.include_think),
            "think_fallback": args.think_fallback,
            "require_think": bool(args.require_think),
            "sft_collection": bool(args.sft_collection),
            "seed": args.seed,
            "model_name": args.model_name,
            "max_tasks": args.max_tasks,
            "collection_task_limit": args.collection_task_limit,
            "collection_source_task_count": collection_source_task_count,
            "collection_excluded_historical_task_count": int(collection_excluded_historical_task_count),
            "rollout_concurrency": int(TEACHER_ROLLOUT_CONCURRENCY),
            "actor_request_concurrency": int(TEACHER_ACTOR_REQUEST_CONCURRENCY),
            "user_request_concurrency": int(TEACHER_USER_REQUEST_CONCURRENCY),
            "test_set_manifest_path": str(test_set_manifest_path),
            "test_set_name": selected_set_name,
            "test_task_count": selected_task_count,
            "test_selected_env_counts": selected_env_counts,
            "task_pool_manifest_path": str(pool_manifest_path) if pool_manifest_path else None,
            "task_pool_name": pool_name,
            "task_pool_split": pool_split,
            "task_pool_hash": task_pool_hash,
            "selected_task_pool_hash": selected_task_pool_hash,
            "task_pool_source_hash": task_pool_source_hash,
            "pass_k": 2 if args.sft_collection else max(args.pass_k or [1]),
            "pass_definition": "completion_success==1",
            "early_stop": True,
            "api_endpoint_label": api_endpoint_label,
            "user_api_endpoint_label": user_api_endpoint_label,
            "user_model_name": os.environ.get("USER_MODEL_NAME", "gpt-4o"),
            "collection_run_id": run_id if args.sft_collection else None,
            "tool_schema": function,
            "task_manifest": travel_manifest,
        },
        code_revision=revision,
    )
    eval_manifest["task_manifest"] = travel_manifest
    eval_manifest["test_set_manifest_path"] = str(test_set_manifest_path)
    eval_manifest["test_set_manifest"] = test_set_manifest
    eval_manifest["test_set_name"] = selected_set_name
    eval_manifest["test_task_count"] = selected_task_count
    eval_manifest["test_selected_env_counts"] = selected_env_counts

    if os.path.exists(f"{PROJECT_ROOT}/{args.save_name}_results.json"):
        results = json.load(open(f"{PROJECT_ROOT}/{args.save_name}_results.json", "r"))
    else:
        results = {}
    if os.path.exists(f"{PROJECT_ROOT}/{args.save_name}_reward_cache.json"):
        reward_cache = json.load(open(f"{PROJECT_ROOT}/{args.save_name}_reward_cache.json", "r"))
    else:
        reward_cache = {}

    # Resume is safe only when the protocol/task manifest is unchanged.
    for existing in (results, reward_cache):
        previous = existing.get("_protocol_manifest") if isinstance(existing, dict) else None
        if isinstance(existing, dict) and previous is None:
            legacy_entries = [key for key in existing if not str(key).startswith("_")]
            if legacy_entries:
                raise ValueError(
                    "existing evaluation cache has no protocol manifest; "
                    "start a new save_name or migrate it explicitly"
                )
        if previous and (
            previous.get("task_manifest") != eval_manifest["task_manifest"]
            or previous.get("config") != eval_manifest["config"]
        ):
            raise ValueError("existing evaluation cache uses a different TravelGym manifest or sampling configuration")
        if isinstance(existing, dict):
            existing["_protocol_manifest"] = eval_manifest

    # Commit the contract before any model calls so even an interrupted first
    # pass leaves a verifiable resume anchor.
    atomic_json_dump(f"{PROJECT_ROOT}/{args.save_name}_manifest.json", eval_manifest)

    if args.sft_collection:
        # Explicit pass-indexed Teacher collection.  This branch is separate
        # from the legacy evaluator's ``pass_k`` aggregation: a successful
        # ``env::task::0`` or ``env::task::1`` cache record is never billed a
        # second time on resume.
        strict_identity = bool(pool_manifest) and str(pool_manifest.get("strict_task_identity", False)).strip().casefold() in {
            "true", "1", "yes", "y"
        }
        if pool_manifest is None or not strict_identity:
            raise ValueError("SFT collection requires a strict reviewed task-pool manifest")
        cache = TeacherCache(
            collection_path,
            collection_run_id=run_id,
            model=args.model_name,
            thinking="enabled",
            reasoning_effort="high",
            max_turns=25,
            revision=revision,
            task_pool_hash=task_pool_hash,
            api_endpoint_label=api_endpoint_label,
        )
        pool_tasks = [
            {"env_name": env_name, "task_id": task_id}
            for env_name in selected_envs
            for task_id in records_by_env.get(env_name, [])
        ]
        if args.collection_task_limit is not None:
            if args.collection_task_limit <= 0:
                raise ValueError("--collection-task-limit must be positive when provided")
            # A limited smoke run should exercise genuinely new Task
            # identities instead of silently reusing an earlier paid pass.
            # Retryable ``error`` records are still eligible; in-flight,
            # invalid and successful records are already provider attempts.
            started_task_keys = {
                str(value.get("provenance", {}).get("task_key"))
                for value in cache.records.values()
                if isinstance(value, Mapping)
                and value.get("status") in {"in_flight", "invalid", "abandoned", "success"}
                and isinstance(value.get("provenance"), Mapping)
            }
            fresh_tasks = [
                task
                for task in pool_tasks
                if f"{task['env_name']}::{task['task_id']}" not in started_task_keys
            ]
            pool_tasks = fresh_tasks[: args.collection_task_limit]
            print(
                f"Teacher collection limit: selected {len(pool_tasks)} fresh Task(s) "
                f"from {len(fresh_tasks)} not-yet-started Task(s)"
            )
        pending = cache.pending(pool_tasks, pass_k=2)
        if args.dry_run:
            print(json.dumps({
                "mode": "sft_collection_dry_run",
                "task_count": len(pool_tasks),
                "pending_passes": len(pending),
                "pending": pending,
                "collection_cache": str(collection_path),
            }, ensure_ascii=False, indent=2))
            return

        collection_tracking = None
        tracking_config = {
            "model": args.model_name,
            "task_pool_hash": task_pool_hash,
            "pass_k": 2,
            "thinking": "enabled",
            "reasoning_effort": "high",
            "max_turns": int(args.max_turns),
            "code_revision": revision,
            "api_endpoint_label": api_endpoint_label,
            "task_count": len(pool_tasks),
            "pool_task_count_before_limit": int(collection_source_task_count or len(pool_tasks)),
            "excluded_historical_task_count": int(collection_excluded_historical_task_count),
            "collection_task_limit": args.collection_task_limit,
            "rollout_concurrency": int(TEACHER_ROLLOUT_CONCURRENCY),
            "actor_request_concurrency": int(TEACHER_ACTOR_REQUEST_CONCURRENCY),
            "user_request_concurrency": int(TEACHER_USER_REQUEST_CONCURRENCY),
            "collection_run_id": run_id,
        }
        # Use the collection ID as SwanLab's stable run ID.  It is generated
        # once for a new cache and recovered from the cache on resume, so the
        # smoke and full phases remain one logical collection run.
        try:
            from verl.utils.tracking import Tracking

            previous_swan_id = os.environ.get("SWANLAB_RUN_ID")
            previous_swan_resume = os.environ.get("SWANLAB_RESUME")
            previous_swan_tags = os.environ.get("SWANLAB_TAGS")
            safe_swan_id = re.sub(r"[^A-Za-z0-9_.-]+", "-", run_id).strip("-") or "teacher"
            os.environ["SWANLAB_RUN_ID"] = safe_swan_id
            os.environ["SWANLAB_RESUME"] = "allow"
            os.environ["SWANLAB_TAGS"] = "teacher,thinking-enabled,pass-k-2"
            try:
                collection_tracking = Tracking(
                    project_name="TravelGym",
                    experiment_name=f"{safe_swan_id}_collection",
                    default_backend=["swanlab"],
                    config=tracking_config,
                )
            finally:
                if previous_swan_id is None:
                    os.environ.pop("SWANLAB_RUN_ID", None)
                else:
                    os.environ["SWANLAB_RUN_ID"] = previous_swan_id
                if previous_swan_resume is None:
                    os.environ.pop("SWANLAB_RESUME", None)
                else:
                    os.environ["SWANLAB_RESUME"] = previous_swan_resume
                if previous_swan_tags is None:
                    os.environ.pop("SWANLAB_TAGS", None)
                else:
                    os.environ["SWANLAB_TAGS"] = previous_swan_tags
            collection_tracking.log(
                {
                    "collection/task_count": len(pool_tasks),
                    "collection/pending_passes": len(pending),
                },
                step=0,
            )
        except Exception as exc:
            # A monitoring outage must not corrupt the paid-request cache.  The
            # local collection metadata still records all labels and stats.
            print(f"SwanLab collection tracking unavailable: {exc}")

        # Load each variant once and index by authoritative task ID.  The
        # private ``gold`` field never enters the model messages.
        data_by_task: dict[tuple[str, str], dict[str, Any]] = {}
        for env_name in selected_envs:
            for item in await load_data(env_name, split="train", task_ids=records_by_env.get(env_name, [])):
                data_by_task[(env_name, str(item["gold"]))] = item
        async def collect_pending_item(item: dict[str, Any]) -> None:
            """Collect one claimed pass; the shared semaphore bounds API load."""

            env_name, task_id, pass_index = item["env_name"], item["task_id"], int(item["pass_index"])
            provenance = make_provenance(
                env_name=env_name,
                task_id=task_id,
                pass_index=pass_index,
                model=args.model_name,
                collection_run_id=run_id,
                thinking="enabled",
                reasoning_effort="high",
                max_turns=args.max_turns,
                revision=revision,
                task_pool_hash=task_pool_hash,
                api_endpoint_label=api_endpoint_label,
            )
            request_id = cache.claim(
                env_name=env_name,
                task_id=task_id,
                pass_index=pass_index,
                provenance=provenance,
            )
            if not request_id:
                return
            data_item = data_by_task.get((env_name, task_id))
            if data_item is None:
                cache.record_error(
                    env_name=env_name,
                    task_id=task_id,
                    pass_index=pass_index,
                    error="task_not_loaded",
                    provenance=provenance,
                )
                return
            started = time.perf_counter()
            try:
                result = await limited_rollout(
                    copy.deepcopy(data_item), client, function, args.temperature, args.max_turns,
                    args.model_name, args.thinking, args.seed, True, "omit", True,
                    "high", pass_index, provenance, user_model_client=user_client,
                )
                report = result.get("reward_report") or {}
                valid = bool(report.get("reward_valid", True)) and result.get("data") is not None
                telemetry = result.get("telemetry") or {}
                cache.record_success(
                    env_name=env_name,
                    task_id=task_id,
                    pass_index=pass_index,
                    trajectory=result.get("data", {}),
                    provenance=provenance,
                    token_count=int(telemetry.get("api_total_tokens", 0) or 0),
                    elapsed_seconds=float(time.perf_counter() - started),
                    estimated_cost=(int(telemetry.get("api_total_tokens", 0) or 0) / 1000.0) * float(args.estimated_cost_per_1k_tokens),
                    valid=valid,
                    missing_reasoning_count=int(telemetry.get("missing_think_turns", 0) or 0),
                )
            except Exception as exc:
                # A timeout/connection failure may occur after the provider
                # accepted the request. Keep the in-flight marker until a
                # human reconciles it so a resume cannot double-bill.
                cache.record_error(
                    env_name=env_name,
                    task_id=task_id,
                    pass_index=pass_index,
                    error=str(exc),
                    retryable=False,
                    provenance=provenance,
                )

        # A queue keeps the endpoint saturated when rollout latencies differ;
        # a slow pass no longer creates a batch barrier for every other worker.
        # Claims happen before each paid request and cache writes are atomic,
        # so queue scheduling does not change pass-level idempotency.
        pending_queue: asyncio.Queue[dict[str, Any]] = asyncio.Queue()
        for item in pending:
            pending_queue.put_nowait(item)
        progress_count = 0
        progress_lock = asyncio.Lock()

        async def collection_worker(worker_index: int) -> None:
            nonlocal progress_count
            while True:
                try:
                    item = pending_queue.get_nowait()
                except asyncio.QueueEmpty:
                    return
                try:
                    await collect_pending_item(item)
                except asyncio.CancelledError:
                    raise
                except Exception as exc:
                    # ``collect_pending_item`` records expected API/rollout
                    # failures.  Keep a worker alive for an unexpected local
                    # error so the remaining queue can still drain.
                    print(
                        f"Teacher worker {worker_index} failed for "
                        f"{item.get('task_key')}::{item.get('pass_index')}: "
                        f"{_provider_error_label(exc)}"
                    )
                finally:
                    pending_queue.task_done()
                    async with progress_lock:
                        progress_count += 1
                        if (
                            collection_tracking is not None
                            and (
                                progress_count % TEACHER_TRACKING_LOG_EVERY == 0
                                or pending_queue.empty()
                            )
                        ):
                            collection_tracking.log(
                                {
                                    "collection/completed_tasks": int(cache.stats.get("completed_tasks", 0)),
                                    "collection/in_flight_passes": int(cache.stats.get("in_flight_passes", 0)),
                                    "collection/queue_remaining": int(pending_queue.qsize()),
                                    "collection/worker_progress": int(progress_count),
                                },
                                step=progress_count,
                            )

        worker_count = min(TEACHER_ROLLOUT_CONCURRENCY, len(pending))
        workers = [
            asyncio.create_task(collection_worker(index))
            for index in range(worker_count)
        ]
        try:
            await pending_queue.join()
            if workers:
                await asyncio.gather(*workers)
        except asyncio.CancelledError:
            for worker in workers:
                worker.cancel()
            if workers:
                await asyncio.gather(*workers, return_exceptions=True)
            raise
        pass_stats = summarize_pass_stats(cache.records)
        collection_metrics = {f"collection/{key}": value for key, value in cache.stats.items()}
        for pass_index, pass_summary in pass_stats.items():
            collection_metrics[f"collection/pass_{pass_index}_attempted"] = int(pass_summary["attempted"])
            collection_metrics[f"collection/pass_{pass_index}_success"] = int(pass_summary["success"])
            collection_metrics[f"collection/pass_{pass_index}_invalid"] = int(pass_summary["invalid"])
            collection_metrics[f"collection/pass_{pass_index}_error"] = int(pass_summary["error"])
            collection_metrics[f"collection/pass_{pass_index}_success_rate"] = float(pass_summary["success_rate"])
        tracking_payload = {
            **tracking_config,
            "stats": cache.stats,
            "pass_stats": pass_stats,
            **collection_metrics,
        }
        atomic_json_dump(
            f"{PROJECT_ROOT}/{args.save_name}_collection_tracking.json",
            tracking_payload,
        )
        # Collection metrics are scalar-only.  SwanLab receives labels at init
        # and aggregate counters here; cache transcripts/reasoning/private IDs
        # remain local.
        if collection_tracking is not None:
            try:
                collection_tracking.log(collection_metrics, step=int(cache.stats.get("completed_tasks", 0)))
                collection_tracking.finish()
            except Exception as exc:
                print(f"SwanLab collection tracking finish unavailable: {exc}")
        print(json.dumps(tracking_payload, ensure_ascii=False, indent=2))
        return

    for env in args.envs:
        manifest_task_ids = records_by_env.get(env, [])
        if not manifest_task_ids:
            print(f"Skipping {env}: no tasks in {selected_set_name}")
            continue
        print(f"Evaluating {env}...")
        data = await load_data(env, split=pool_split, task_ids=manifest_task_ids)
        if args.max_tasks is not None:
            if args.max_tasks <= 0:
                raise ValueError("--max_tasks must be positive when provided")
            data = data[: args.max_tasks]
            print(f"Limiting {env} to {len(data)} task(s) for this run")
        if env not in results:
            results[env] = {}
        if env not in reward_cache:
            reward_cache[env] = {}
        
        for pass_k in args.pass_k:
            if str(pass_k) in results[env]:
                print(f"Pass {pass_k} already evaluated, skipping...")
                continue

            async def run_task_passes(task_data):
                """Run attempts for one task sequentially with task-level early stop."""

                data_id = hash(task_data)
                task_cache = reward_cache[env].get(data_id)
                existing_number = (
                    len(task_cache.get("reward", []))
                    if isinstance(task_cache, dict)
                    else 0
                )
                existing_reports = (
                    task_cache.get("reward_report", []) or []
                    if isinstance(task_cache, dict)
                    else []
                )
                if any(_is_successful_completion(report) for report in existing_reports):
                    print(f"Data {data_id} already passed; task-level early stop")
                    return []
                if existing_number >= pass_k:
                    print(f"Data {data_id} already has enough rollouts, skipping...")
                    return []

                task_rewards = []
                for attempt_index in range(existing_number, pass_k):
                    task_rewards.append(
                        await limited_rollout(
                            copy.deepcopy(task_data),
                            client,
                            function,
                            args.temperature,
                            args.max_turns,
                            args.model_name,
                            args.thinking,
                            args.seed,
                            args.include_think,
                            args.think_fallback,
                            args.require_think,
                            pass_index=attempt_index + 1,
                            user_model_client=user_client,
                        )
                    )
                    if _is_successful_completion(task_rewards[-1].get("reward_report")):
                        print(
                            f"Data {data_id} passed on attempt {attempt_index + 1}; "
                            "task-level early stop"
                        )
                        break
                return task_rewards

            # Tasks may run concurrently, but their pass@k attempts never do:
            # once one attempt succeeds, no later attempt for that task starts.
            reward_groups = await asyncio.gather(
                *(run_task_passes(d) for d in data)
            )

            # Process the rewards
            for r in rewards:
                hash_id = r["hash_id"]
                reward = r["reward"]
                reward_report = r.get("reward_report")
                history = r["history"]
                rollout_data = r["data"]
                post_processed_reward = reward
                if hash_id not in reward_cache[env]:
                    reward_cache[env][hash_id] = {
                        "history": [],
                        "reward": [],
                        "reward_report": [],
                        "data": [],
                        "telemetry": [],
                    }
                reward_cache[env][hash_id]["history"].append(history)
                reward_cache[env][hash_id]["data"].append(rollout_data)
                reward_cache[env][hash_id]["reward"].append(post_processed_reward)
                reward_cache[env][hash_id].setdefault("reward_report", []).append(reward_report)
                reward_cache[env][hash_id].setdefault("telemetry", []).append(r.get("telemetry", {}))
                # Flush after each task rollout.  A crash can therefore
                # resume from the completed task rather than discarding the
                # whole pass; the aggregate result is committed only after
                # the pass finishes.
                atomic_json_dump(
                    f"{PROJECT_ROOT}/{args.save_name}_reward_cache.json",
                    reward_cache,
                )
            
            # Post-process the results
            results = await post_process_results(results, reward_cache, env, pass_k)

            save_dir = args.save_name.rsplit("/", 1)[0]
            if not os.path.exists(f"{PROJECT_ROOT}/{save_dir}"):
                os.makedirs(f"{PROJECT_ROOT}/{save_dir}")

            atomic_json_dump(f"{PROJECT_ROOT}/{args.save_name}_results.json", results)
            atomic_json_dump(f"{PROJECT_ROOT}/{args.save_name}_reward_cache.json", reward_cache)
            atomic_json_dump(f"{PROJECT_ROOT}/{args.save_name}_manifest.json", eval_manifest)
        

if __name__ == "__main__":
    asyncio.run(main())


    
    
    
