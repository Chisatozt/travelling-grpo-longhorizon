# Copy this file to .env and fill in the values you need.
# .env is ignored by git; never commit a real API key.

# OpenAI-compatible endpoint (DeepSeek example)
OPENAI_API_KEY=
# Alternatively, set DEEPSEEK_API_KEY; OPENAI_API_KEY takes precedence.
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# Actor and TravelGym user-simulator models
ACTOR_MODEL_NAME=deepseek-v4-flash
USER_MODEL_NAME=deepseek-v4-flash

# Evaluator/runtime settings
# Legacy evaluator knob. Teacher collection uses the three explicit settings
# below; start high and reduce them if the provider reports throttling.
MAX_WORKER_NUM=16
TEACHER_ROLLOUT_CONCURRENCY=16
TEACHER_ACTOR_REQUEST_CONCURRENCY=24
TEACHER_USER_REQUEST_CONCURRENCY=24
TEACHER_TRACKING_LOG_EVERY=8
TOOL_CHOICE=auto
MAX_OUTPUT_TOKENS=4096
OPENAI_REQUEST_TIMEOUT=60
TRAVELGYM_USER_TIMEOUT=30
MODEL_MAX_ATTEMPTS=3
# DeepSeek V4 Flash Teacher mode; CLI --thinking takes precedence.
DEEPSEEK_THINKING=enabled

# SwanLab training monitoring. Use mode=local/offline on a server without
# network access; online mode requires a SwanLab API key.
SWANLAB_API_KEY=
SWANLAB_MODE=online
SWANLAB_LOG_DIR=swanlog
TRAINER_LOGGER=swanlab

# Training launcher (optional for local API/SFT collection; required by
# examples/sglang_multiturn/train.sh unless passed in the shell).
# ACTOR_MODEL_PATH=Qwen/Qwen3.5-4B
# CUDA_VISIBLE_DEVICES=0
# N_GPUS_PER_NODE=1

# Optional provider/API settings
GENAI_API_KEY=
SERPER_API_KEY=

# Optional paths. eval.py defaults PROJECT_ROOT to this repository's eval/ dir.
# PROJECT_ROOT=
# TRAVEL_MANIFEST_PATH=
# TRAVEL_TASK_POOL_MANIFEST=data/task_pools/travel_task_pools.json
# CODE_REVISION=
